julia /home/morah/TestTraceTradeoff/code/mainhpc_finish.jl 0.0 0.0 0.3 2.0 "negativebinomial" "empirical" 4 1.0000000000000004&
julia /home/morah/TestTraceTradeoff/code/mainhpc_finish.jl 0.0 0.0 0.3 2.0 "negativebinomial" "empirical" 5 1.0000000000000004&
julia /home/morah/TestTraceTradeoff/code/mainhpc_finish.jl 0.0 0.0 0.3 2.0 "negativebinomial" "empirical" 6 1.0000000000000004&
