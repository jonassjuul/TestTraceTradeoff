julia /home/morah/TestTraceTradeoff/code/mainhpc.jl 1.0 15.0 0.3 2.0 "poisson" "empirical"
julia /home/morah/TestTraceTradeoff/code/mainhpc.jl 1.0 16.0 0.3 2.0 "poisson" "empirical"
