#!/bin/bash

#SBATCH --job-name=simple        # Job name
#SBATCH --output=/home/morah/TestTraceTradeoff/jobOutputs/job.%j.out 
#SBATCH --error=/home/morah/TestTraceTradeoff/jobOutputs/job.%j.err 
#SBATCH --cpus-per-task=1        # Schedule one core
#SBATCH --nodelist=cn3
#SBATCH --time=02:00:00     
#SBATCH --partition=scavenge    # Run on scavenge queue (all nodes, low priority)

# Print out the hostname of the node the job is running on

module load Julia

hostname

# Run the Julia script
julia /home/morah/TestTraceTradeoff/code/main.jl